    function telechargerQR(id) {
      const s = stagiaires.filter(function(x) { return x.id === id; })[0];
      if (!s) return;
      const a = document.createElement('a');
      a.href = qrDataUrl(stuQrPayload(s));
      a.download = 'QR-' + s.nom.replace(/\s+/g, '-') + '-' + s.code + '.png';
      document.body.appendChild(a);
      a.click();
      a.remove();
