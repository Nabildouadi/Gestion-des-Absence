    // ===== QR Codes =====
    function stuQrPayload(s) {
      const t = normaliserTel(s.tel || '');
      return /^0[5-7]\d{8}$/.test(t) ? t : (s.code || '');
    }

    function stuQrTrouver(payload) {
      const brut = (payload || '').trim();
      if (!brut) return null;
      const parCode = stuTrouverCode(brut.toUpperCase());
      if (parCode) return parCode;
      const t = normaliserTel(brut);
      if (/^\d{10,13}$/.test(t)) return stuTrouverTel(t);
      return null;
    }

    function stuTelLisible(tel) {
      const t = normaliserTel(tel || '');
      if (!/^\d{10}$/.test(t)) return t;
      return t.slice(0, 4) + ' ' + t.slice(4, 6) + ' ' + t.slice(6, 8) + ' ' + t.slice(8, 10);
    }

    function qrImg(payload, taille) {
      try {
        if (typeof qrcode === 'function') {
          const qr = qrcode(0, 'M');
          qr.addData(payload);
          qr.make();
          return qr.createImgTag(taille || 4, 0);
        }
      } catch (e) {}
      return '<div style="width:' + ((taille || 4) * 26) + 'px;height:' + ((taille || 4) * 26) + 'px;border:1px dashed #94a3b8;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:0.7rem;color:#64748b;text-align:center;padding:0.4rem;">QR<br>' + escHtml(payload) + '</div>';
    }

