    // ===== Export du projet (ZIP sans compression) =====
    function crc32Octets(buf) {
      let crc = 0xFFFFFFFF;
      for (let n = 0; n < buf.length; n++) {
        let c = (crc ^ buf[n]) & 0xFF;
        for (let k = 0; k < 8; k++) c = (c & 1) ? ((c >>> 1) ^ 0xEDB88320) : (c >>> 1);
        crc = (crc >>> 8) ^ c;
      }
      return (crc ^ 0xFFFFFFFF) >>> 0;
    }

    function zipCreer(fichiers) {
      const enc = new TextEncoder();
      const parts = [];
      const central = [];
      let offset = 0;
      const now = new Date();
      const dt = (((now.getHours() & 31) << 11) | ((now.getMinutes() & 63) << 5) | ((now.getSeconds() / 2) & 31)) & 0xFFFF;
      const dd = (((now.getFullYear() - 1980) & 127) << 9) | (((now.getMonth() + 1) & 15) << 5) | (now.getDate() & 31);
      fichiers.forEach(function(f) {
        const data = typeof f.contenu === 'string' ? enc.encode(f.contenu) : f.contenu;
        const nom = enc.encode(f.nom);
        const crc = crc32Octets(data);
        const lh = new Uint8Array(30 + nom.length);
        const lv = new DataView(lh.buffer);
        lv.setUint32(0, 0x04034b50, true);
        lv.setUint16(4, 20, true);
        lv.setUint16(6, 0x0800, true);
        lv.setUint16(8, 0, true);
        lv.setUint16(10, dt, true);
        lv.setUint16(12, dd, true);
        lv.setUint32(14, crc, true);
        lv.setUint32(18, data.length, true);
        lv.setUint32(22, data.length, true);
        lv.setUint16(26, nom.length, true);
        lh.set(nom, 30);
        parts.push(lh, data);

        const ch = new Uint8Array(46 + nom.length);
        const cv = new DataView(ch.buffer);
        cv.setUint32(0, 0x02014b50, true);
        cv.setUint16(4, 20, true);
        cv.setUint16(6, 20, true);
        cv.setUint16(8, 0x0800, true);
        cv.setUint16(10, 0, true);
        cv.setUint16(12, dt, true);
        cv.setUint16(14, dd, true);
        cv.setUint32(16, crc, true);
        cv.setUint32(20, data.length, true);
        cv.setUint32(24, data.length, true);
        cv.setUint16(28, nom.length, true);
        cv.setUint32(42, offset, true);
        ch.set(nom, 46);
        central.push(ch);
        offset += lh.length + data.length;
      });
      const cdSize = central.reduce(function(t, c) { return t + c.length; }, 0);
      const eocd = new Uint8Array(22);
      const ev = new DataView(eocd.buffer);
      ev.setUint32(0, 0x06054b50, true);
      ev.setUint16(8, fichiers.length, true);
      ev.setUint16(10, fichiers.length, true);
      ev.setUint32(12, cdSize, true);
      ev.setUint32(16, offset, true);
      return new Blob(parts.concat(central, [eocd]), { type: 'application/zip' });
    }

