        if (!groupes[nom]) groupes[nom] = { salle: nom, inscrits: [], n: 0, qr: 0, pres: 0, abs: 0, ret: 0, just: 0, seances: 0, manq: {} };
        groupes[nom].inscrits.push(s.id);
      });

      const cles = Object.keys(groupes).sort(function(a, b) { return a.localeCompare(b, 'fr'); });
      cles.forEach(function(k) {
        const g = groupes[k];
        const membres = {};
        g.inscrits.forEach(function(id) { membres[id] = true; });
        courant.forEach(function(a) {
          const st = a.statuts || {};
          const h = a.heures || {};
          const membresPris = Object.keys(membres).filter(function(id) { return st[id]; });
          if (!membresPris.length) return;
          g.seances++;
          membresPris.forEach(function(id) {
            const s = st[id];
            if (s === 'present') g.pres++;
            else if (s === 'absent') { g.abs++; (g.manq[a.date + '|' + a.creneau] = g.manq[a.date + '|' + a.creneau] || []).push(id); }
            else if (s === 'retard') g.ret++;
            else if (s === 'just') g.just++;
            const hh = h[id];
            if (hh && (hh.source === 'qr' || hh.source === 'qr-stagiaire')) g.qr++;
          });
        });
        g.total = g.inscrits.length * g.seances;
        g.taux = g.total ? Math.round(((g.pres + g.ret) / g.total) * 100) : 0;
      });
      return cles.map(function(k) { return groupes[k]; });
    }

