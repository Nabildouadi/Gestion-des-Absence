    function stuPhotoChanged(input) {
      const file = input.files && input.files[0];
      if (!file) return;
      if (file.size > 8 * 1024 * 1024) { showToast('Photo trop lourde (8 Mo maximum)', 'fas fa-exclamation-triangle', true); input.value = ''; return; }
      const fr = new FileReader();
      fr.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const max = 300;
          let w = img.width, h = img.height;
          if (w > max || h > max) { const r = Math.min(max / w, max / h); w = Math.max(1, Math.round(w * r)); h = Math.max(1, Math.round(h * r)); }
          const cv = document.createElement('canvas');
          cv.width = w; cv.height = h;
          cv.getContext('2d').drawImage(img, 0, 0, w, h);
          photoTmp = cv.toDataURL('image/jpeg', 0.8);
          const prev = document.getElementById('stuPhotoPreview');
          prev.src = photoTmp;
          prev.style.display = 'block';
          document.getElementById('stuPhotoIcon').style.display = 'none';
        };
        img.src = e.target.result;
      };
      fr.readAsDataURL(file);
      input.value = '';
    }

