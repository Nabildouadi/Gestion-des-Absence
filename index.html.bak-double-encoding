    const SEMESTRES = ['S1', 'S2', 'S3', 'S4', 'S5', 'â€”'];

    function stuGroupeSpec(s) { return (s && s.specialite ? String(s.specialite).trim() : '') || 'â€”'; }
    function stuGroupeSem(s) { return (s && s.semestre ? String(s.semestre).trim().toUpperCase() : '') || 'â€”'; }
    function stuGroupeCle(s) { return stuGroupeSpec(s) + '|' + stuGroupeSem(s); }
    function stuGroupeId(s) { return stuGroupeCle(s).replace(/\|/g, '||').replace(/\s+/g, ' ').trim(); }
    function stuGroupeNom(g) { return g.spec + ' â€” ' + g.sem; }

    function stuGroupeTri(a, b) {
      if (a.spec !== b.spec) return a.spec.localeCompare(b.spec, 'fr');
      return SEMESTRES.indexOf(a.sem) - SEMESTRES.indexOf(b.sem);
    }

    function stuGroupes(list) {
      const src = list || stagiaires;
      const map = {};
      src.forEach(function(s) {
        const cle = stuGroupeCle(s);
        if (!map[cle]) map[cle] = { cle: cle, spec: stuGroupeSpec(s), sem: stuGroupeSem(s), membres: [] };
        map[cle].membres.push(s);
      });
      return Object.keys(map).map(function(k) { return map[k]; }).map(function(g) {
        g.nom = stuGroupeNom(g);
        g.eff = g.membres.length;
        g.salles = {};
        g.membres.forEach(function(s) { const p = (s.salle || '').trim() || 'â€”'; g.salles[p] = (g.salles[p] || 0) + 1; });
        return g;
